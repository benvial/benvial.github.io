#!/bin/bash
# Compile the FEniCS forms of the gyptis notebooks at image build time, so the
# JIT cache ships with the image and live sessions skip form compilation (see
# warmup.py). The cache location is pinned (see start): dijitso otherwise picks
# it from CONDA_PREFIX, which differs between the build and the running kernel.
set -euo pipefail
export DIJITSO_CACHE_DIR="$HOME/.cache/dijitso"
python "$(dirname "$0")/warmup.py"
