---
// Arrow used by doors and row links; external variant points up-right.
interface Props {
  external?: boolean;
  class?: string;
}
const { external = false, class: className = "size-4" } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="square"
  aria-hidden="true"
  class={className}
>
  {external ? <path d="M7 17 17 7M9 7h8v8" /> : <path d="M4 12h15M13 6l6 6-6 6" />}
</svg>
