---
import { nav, site, socials } from "@/data/site";
const year = new Date().getFullYear();
---

<footer class="on-ink mt-24 bg-paper">
  <div class="page grid gap-10 py-12 md:grid-cols-12">
    <div class="md:col-span-5">
      <p class="t-display">{site.name}</p>
      <p class="mt-4 max-w-[34ch] text-ink-2">
        Wave physics research and scientific software.
      </p>
      {
        site.email && (
          <p class="mt-4">
            <a class="link" href={`mailto:${site.email}`}>
              {site.email}
            </a>
          </p>
        )
      }
    </div>
    <nav aria-label="Footer" class="md:col-span-3">
      <h2 class="t-label text-ink-3">Site</h2>
      <ul class="mt-3 grid gap-1.5">
        {
          nav.map((item) => (
            <li>
              <a class="link no-underline hover:underline" href={item.href}>
                {item.title}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="md:col-span-4">
      <h2 class="t-label text-ink-3">Elsewhere</h2>
      <ul class="mt-3 grid gap-1.5">
        {
          socials.map((s) => (
            <li class="flex items-baseline justify-between gap-4 border-b border-rule-2 pb-1.5">
              <a class="link no-underline hover:underline" href={s.href} rel="me noopener">
                {s.title}
              </a>
              <span class="t-mono text-ink-3">{s.handle}</span>
            </li>
          ))
        }
        <li class="flex items-baseline justify-between gap-4 border-b border-rule-2 pb-1.5">
          <a class="link no-underline hover:underline" href="/rss.xml">RSS</a>
          <span class="t-mono text-ink-3">/rss.xml</span>
        </li>
        <li class="flex items-baseline justify-between gap-4 pb-1.5">
          <a class="link no-underline hover:underline" href={site.cv}>CV</a>
          <span class="t-meta">PDF</span>
        </li>
      </ul>
    </div>
  </div>
  <div class="page flex flex-wrap justify-between gap-2 border-t border-rule py-5 text-ink-3">
    <p class="t-meta not-italic">© {year} {site.name}</p>
    <p class="t-meta">Fields on this site are solved in your browser with P1 finite elements.</p>
  </div>
</footer>
