---
import Logo from "@/components/assets/Logo.astro";
import { nav, site } from "@/data/site";

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header data-site-header class="site-header sticky top-0 z-20 border-b border-rule bg-paper-bar">
  <div class="page flex min-h-16 items-center justify-between gap-6 py-3">
    <a
      href="/"
      class="t-label flex shrink-0 items-center gap-3 text-[0.9375rem] tracking-[0.05em] text-ink hover:text-warm"
      aria-current={path === "/" ? "page" : undefined}
    >
      <Logo class="size-7" aria-hidden="true" />
      {site.name}
    </a>

    <nav aria-label="Main" class="hidden lg:block">
      <ul class="flex items-center gap-x-6 xl:gap-x-8">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? "page" : undefined}
                class="t-label relative py-2 text-ink-2 transition-colors hover:text-ink aria-[current=page]:text-warm aria-[current=page]:after:absolute aria-[current=page]:after:inset-x-0 aria-[current=page]:after:-bottom-px aria-[current=page]:after:h-[2px] aria-[current=page]:after:bg-warm"
              >
                {item.title}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <details class="nav-menu lg:hidden">
      <summary
        class="t-label flex min-h-11 cursor-pointer list-none items-center gap-2 border border-ink px-3 text-ink [&::-webkit-details-marker]:hidden"
      >
        <span class="when-closed">Menu</span><span class="when-open">Close</span>
      </summary>
      <nav aria-label="Main" class="absolute inset-x-0 top-full border-b border-rule bg-paper-bar">
        <ul class="page rows py-2">
          {
            nav.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={isActive(item.href) ? "page" : undefined}
                  class="t-h2 flex min-h-14 items-center text-ink aria-[current=page]:text-warm"
                >
                  {item.title}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </details>
  </div>
</header>

<script>
  // Hide the bar while reading down, bring it back on any scroll up. The
  // visible height is published as --nav-offset so sticky asides clear it.
  const header = document.querySelector<HTMLElement>("[data-site-header]")!;
  const root = document.documentElement;
  const menu = header.querySelector("details");
  let lastY = window.scrollY;
  let hidden = false;
  let ticking = false;

  const apply = (hide: boolean) => {
    hidden = hide;
    header.toggleAttribute("data-hidden", hide);
    root.style.setProperty("--nav-offset", hide ? "0px" : `${header.offsetHeight}px`);
  };

  const update = () => {
    ticking = false;
    const y = window.scrollY;
    if (y <= header.offsetHeight) {
      lastY = y;
      if (hidden) apply(false);
      return;
    }
    if (Math.abs(y - lastY) < 8) return;
    const hide = y > lastY && !menu?.open && !header.contains(document.activeElement);
    lastY = y;
    if (hide !== hidden) apply(hide);
  };

  window.addEventListener(
    "scroll",
    () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    },
    { passive: true },
  );
  header.addEventListener("focusin", () => hidden && apply(false));
  new ResizeObserver(() => apply(hidden)).observe(header);
  update();
</script>

<style>
  .site-header {
    transition: transform 0.3s ease;
  }
  .site-header[data-hidden] {
    transform: translateY(-100%);
  }
  @media (prefers-reduced-motion: reduce) {
    .site-header {
      transition: none;
    }
  }
  .nav-menu .when-open {
    display: none;
  }
  .nav-menu[open] .when-open {
    display: inline;
  }
  .nav-menu[open] .when-closed {
    display: none;
  }
  .nav-menu .rows > li:first-child {
    border-top: 0;
  }
  .nav-menu .rows > li:last-child {
    border-bottom: 0;
  }
</style>
