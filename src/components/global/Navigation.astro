---
import Logo from "@/components/assets/Logo.astro";
import { nav, site } from "@/data/site";

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="relative z-20 bg-paper">
  <div class="page flex min-h-16 items-center justify-between gap-6 py-3">
    <a
      href="/"
      class="t-label flex shrink-0 items-center gap-3 text-[0.9375rem] tracking-[0.05em] text-ink hover:text-warm"
      aria-current={path === "/" ? "page" : undefined}
    >
      <Logo class="size-7" aria-hidden="true" />
      {site.name}
    </a>

    <nav aria-label="Main" class="hidden lg:block">
      <ul class="flex items-center gap-x-6 xl:gap-x-8">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? "page" : undefined}
                class="t-label relative py-2 text-ink-2 transition-colors hover:text-ink aria-[current=page]:text-warm aria-[current=page]:after:absolute aria-[current=page]:after:inset-x-0 aria-[current=page]:after:-bottom-px aria-[current=page]:after:h-[2px] aria-[current=page]:after:bg-warm"
              >
                {item.title}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <details class="nav-menu lg:hidden">
      <summary
        class="t-label flex min-h-11 cursor-pointer list-none items-center gap-2 border border-ink px-3 text-ink [&::-webkit-details-marker]:hidden"
      >
        <span class="when-closed">Menu</span><span class="when-open">Close</span>
      </summary>
      <nav aria-label="Main" class="absolute inset-x-0 top-full border-y border-rule bg-paper">
        <ul class="page rows py-2">
          {
            nav.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={isActive(item.href) ? "page" : undefined}
                  class="t-h2 flex min-h-14 items-center text-ink aria-[current=page]:text-warm"
                >
                  {item.title}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </details>
  </div>
</header>

<style>
  .nav-menu .when-open {
    display: none;
  }
  .nav-menu[open] .when-open {
    display: inline;
  }
  .nav-menu[open] .when-closed {
    display: none;
  }
  .nav-menu .rows > li:first-child {
    border-top: 0;
  }
  .nav-menu .rows > li:last-child {
    border-bottom: 0;
  }
</style>
