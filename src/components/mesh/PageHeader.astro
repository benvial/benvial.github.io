---
import MeshField from "@/components/mesh/MeshField.astro";
import { sourceFor } from "@/components/mesh/source";

interface Props {
  title: string;
  lede?: string;
  sourceX?: number;
  sourceY?: number;
}
const auto = sourceFor(Astro.url.pathname);
const { title, lede, sourceX = auto.sourceX, sourceY = auto.sourceY } = Astro.props;
---

<MeshField class="min-h-[clamp(15rem,34vw,22rem)]" sourceX={sourceX} sourceY={sourceY} wavelengths={10} pad={28} intensity={0.55}>
  <div class="page flex min-h-[inherit] flex-col justify-end gap-4 pt-[clamp(2.5rem,9vh,6rem)] pb-20 lg:pb-36">
    <div data-obstacle class="flex w-fit max-w-full flex-col gap-4 bg-paper">
      <h1 class="t-display">{title}</h1>
      {lede && <p class="t-lede max-w-[36rem]">{lede}</p>}
    </div>
    <slot />
  </div>
</MeshField>
