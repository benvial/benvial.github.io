---
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import { Image } from "astro:assets";

interface Props {
  entries: Array<{
    id: string;
    data: {
      title: string;
      description: string;
      image?: { url: any; alt: string };
      tags?: string[];
    };
  }>;
}

const { entries } = Astro.props as Props;
---

<section>
  <Wrapper variant="standard" class="py-12">
    <Text
      tag="h2"
      variant="displaySM"
      class="text-accent-950 uppercase font-display font-medium text-balance mb-8"
    >
      Research Areas
    </Text>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
      {
        entries.map((entry) => (
          <a
            href={`/research/${entry.id}`}
            class="block group"
            title={`Read more: ${entry.data.title}`}
          >
            <article class="relative flex flex-col justify-between h-full p-6 bg-base-50 min-h-80 transition-all duration-300 hover:bg-accent-500">
              {entry.data.image && (
                <Image
                  src={entry.data.image.url}
                  alt={entry.data.image.alt}
                  class="object-cover object-center w-full aspect-video mb-4"
                  width={600}
                  height={400}
                />
              )}
              <div class="flex flex-col">
                <Text
                  tag="h3"
                  variant="textSM"
                  class="font-medium text-base-900 group-hover:text-white"
                >
                  {entry.data.title}
                </Text>
                <Text
                  tag="p"
                  variant="textSM"
                  class="mt-2 text-base-500 line-clamp-3 group-hover:text-white/80"
                >
                  {entry.data.description}
                </Text>
              </div>
              <div class="mt-3 flex flex-wrap gap-2">
                {entry.data.tags?.map((tag) => (
                  <span class="text-xs uppercase tracking-wider text-base-400 group-hover:text-white/60">
                    {tag}
                  </span>
                ))}
              </div>
            </article>
          </a>
        ))
      }
    </div>
  </Wrapper>
</section>
