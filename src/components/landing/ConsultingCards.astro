---
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import Button from "@/components/fundations/elements/Button.astro";
import ArrowNarrowRight from "@/components/fundations/icons/ArrowNarrowRight.astro";

const services = [
  { title: "Computational Electromagnetics", description: "Full-wave simulation using FEM, FDTD, and BEM. Modal analysis, scattering, and resonance problems." },
  { title: "Multiphysics Modeling", description: "Coupled EM, thermal, mechanical, and electronic simulations. Device-level multiphysics with custom solver integration." },
  { title: "Custom Solver Development", description: "Tailored numerical solvers in Python with FEniCSx, dolfinx, SLEPc, and PETSc for HPC applications." },
  { title: "Simulation Acceleration", description: "Performance optimization via parallel computing, GPU acceleration, and machine learning surrogates for inverse design." },
];
---

<section>
  <Wrapper variant="standard" class="py-12">
    <Text
      tag="h2"
      variant="displaySM"
      class="text-accent-950 uppercase font-display font-medium text-balance mb-8"
    >
      Consulting Services
    </Text>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
      {services.map((s) => (
        <div class="border border-base-200 rounded-lg p-6">
          <h3 class="font-medium text-accent-950 mb-2">{s.title}</h3>
          <p class="text-sm text-base-500">{s.description}</p>
        </div>
      ))}
    </div>

    <div class="flex justify-center">
      <Button isLink={true} href="/consulting" size="base" variant="accent">
        View All Services
        <span slot="right-icon"><ArrowNarrowRight /></span>
      </Button>
    </div>
  </Wrapper>
</section>
