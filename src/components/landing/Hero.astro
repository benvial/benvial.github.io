---
import Text from "@/components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import Plus from "@/components/fundations/icons/Plus.astro";
import ArrowNarrowRight from "@/components/fundations/icons/ArrowNarrowRight.astro";
---

<section class="relative overflow-hidden">
  <Wrapper variant="standard" class="relative pt-48">
    <div class="flex flex-col lg:flex-row lg:items-start lg:gap-12">
      <div class="text-balance flex-1">
        <Text
          tag="h1"
          variant="displayXL"
          class="text-accent-950 uppercase font-display font-medium"
        >
          Benjamin Vial
        </Text>
        <Text
          tag="p"
          variant="displaySM"
          class="text-accent-950/70 font-display font-medium mt-2"
        >
          Wave Physics Research<br />&amp; Scientific Software Consulting
        </Text>
        <div class="grid grid-cols-1 gap-8 lg:grid-cols-2 mt-8 lg:items-end">
          <Text tag="p" variant="textSM" class="text-base-500">
            Research scientist specializing in wave physics, metamaterials, and
            computational electromagnetics. Building open-source tools
            for scientific computing.
          </Text>

          <div class="flex flex-wrap items-center gap-4">
            <Button isLink={true} href="/research" size="base" variant="accent">
              <span slot="left-icon"><Plus /></span>
              View Research
            </Button>
            <Button isLink={true} href="/consulting" size="base" variant="default">
              Work with me
              <span slot="right-icon"><ArrowNarrowRight /></span>
            </Button>
          </div>
        </div>
      </div>
      <div class="mt-8 lg:mt-0 lg:shrink-0">
        <img
          src="/face.jpg"
          alt="Benjamin Vial"
          width="280"
          height="280"
          class="object-cover w-40 h-40 sm:w-56 sm:h-56 lg:w-72 lg:h-72"
        />
      </div>
    </div>
  </Wrapper>
</section>
