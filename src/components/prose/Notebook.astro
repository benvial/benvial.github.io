---
// A Jupyter notebook rendered in prose, with the outputs of a saved run.
// "Run live" makes its code cells editable in place and attaches them to a kernel
// started on mybinder.org from the `binder` branch of `repo` (see src/scripts/notebook.ts and
// binder/README.md). The saved outputs stay on the page until a cell is re-run.
import { Code } from "astro:components";
import { createMarkdownProcessor } from "@astrojs/markdown-remark";
import remarkMath from "remark-math";
import rehypeKatex from "rehype-katex";
import "katex/dist/katex.min.css";
import { CODE_THEME } from "@/scripts/highlight";

interface Props {
  /** File name in src/data/notebooks/ */
  name: string;
  /** GitHub repository holding the notebook on main and the Binder environment on `ref` */
  repo?: string;
  ref?: string;
}

const { name, repo = "benvial/benvial.github.io", ref = "binder" } = Astro.props;

// Notebooks are committed without outputs; the deploy workflow writes executed
// copies to executed/ (scripts/notebooks/execute.py). Without one, as in a fresh
// checkout, the page shows the code alone.
const files = import.meta.glob<string>(["/src/data/notebooks/*.ipynb", "/src/data/notebooks/executed/*.ipynb"], {
  query: "?raw",
  import: "default",
  eager: true,
});
const raw = files[`/src/data/notebooks/executed/${name}`] ?? files[`/src/data/notebooks/${name}`];
if (!raw) throw new Error(`Notebook not found: src/data/notebooks/${name}`);

type Output = {
  output_type: string;
  text?: string | string[];
  data?: Record<string, any>;
};
type Cell = { cell_type: string; source: string | string[]; outputs?: Output[]; metadata?: { alt?: string } };

const join = (s: string | string[] = "") => (Array.isArray(s) ? s.join("") : s);
const cells: Cell[] = JSON.parse(raw).cells;

const md = await createMarkdownProcessor({ remarkPlugins: [remarkMath], rehypePlugins: [rehypeKatex] });
const html = new Map<Cell, string>();
for (const c of cells) {
  if (c.cell_type === "markdown") html.set(c, (await md.render(join(c.source))).code);
}

const IMAGES = ["image/webp", "image/png", "image/jpeg"];
// Plotly figures are drawn client-side (src/scripts/plotly.ts) from their JSON;
const PLOTLY_MIME = "application/vnd.plotly.v1+json";
// "<" is escaped so the JSON cannot close its script tag.
const plotlyJson = (spec: unknown) => JSON.stringify(spec).replace(/</g, "\\u003c");
// The image holds only the environment: nbgitpuller fetches the notebook from main.
const pull = new URLSearchParams({
  repo: `https://github.com/${repo}`,
  branch: "main",
  urlpath: `lab/tree/${repo.split("/")[1]}/src/data/notebooks/${name}`,
});
const binderLab = `https://mybinder.org/v2/gh/${repo}/${ref}?urlpath=${encodeURIComponent(`git-pull?${pull}`)}`;
---

<section class="nb" data-notebook data-repo={repo} data-ref={ref}>
  <div class="nb-bar">
    <div class="nb-actions">
      <button type="button" class="door door--primary" data-nb-run>
        Run live
        <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M3 1.5v11l9-5.5z" fill="currentColor"></path></svg>
      </button>
      <button type="button" class="nb-button" data-nb-interrupt hidden>Interrupt</button>
      <button type="button" class="nb-button" data-nb-restart hidden>Restart kernel</button>
      <button type="button" class="nb-button" data-nb-restart-all hidden>Restart &amp; run all</button>
      <a class="nb-binder link t-meta" href={binderLab} target="_blank" rel="noopener">Open in JupyterLab on Binder&nbsp;↗</a>
    </div>
    <p class="t-meta" data-nb-status aria-live="polite">
      Outputs below come from a saved run. Running live starts a Python kernel on <a class="link" href="https://mybinder.org">mybinder.org</a>, which usually takes a minute or two.
    </p>
  </div>

  {
    cells.map((c) =>
      c.cell_type === "markdown" ? (
        <div class="nb-md" set:html={html.get(c)} />
      ) : c.cell_type === "code" ? (
        <div class="nb-cell" data-cell>
          <button type="button" class="nb-copy" data-nb-copy>Copy</button>
          <div class="nb-in" data-executable data-language="python">
            <Code code={join(c.source)} lang="python" theme={CODE_THEME} />
          </div>
          <div class="nb-out" data-output>
            {(c.outputs ?? []).map((o) => {
              if (o.output_type === "stream") return <pre class="nb-text">{join(o.text)}</pre>;
              if (o.output_type === "error") return null;
              const data = o.data ?? {};
              const fig = data[PLOTLY_MIME];
              if (fig)
                return (
                  <div class="nb-plotly" data-plotly role="figure" aria-label={c.metadata?.alt ?? "Interactive figure"} style={`height: ${fig.layout?.height ?? 450}px`}>
                    <script is:inline type="application/json" set:html={plotlyJson(fig)} />
                    <p class="nb-plotly-wait t-meta">Loading the interactive figure…</p>
                  </div>
                );
              const img = IMAGES.find((t) => t in data);
              if (img) return <img src={`data:${img};base64,${join(data[img])}`} alt={c.metadata?.alt ?? ""} loading="lazy" decoding="async" />;
              if ("text/html" in data) return <div set:html={join(data["text/html"])} />;
              if ("text/plain" in data) return <pre class="nb-text">{join(data["text/plain"])}</pre>;
              return null;
            })}
          </div>
        </div>
      ) : null
    )
  }
</section>

<script>
  import "@/scripts/notebook";
  import "@/scripts/plotly";
</script>
