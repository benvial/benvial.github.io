---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import ConsultingCards from "@/components/landing/ConsultingCards.astro";
---

<BaseLayout>
  <section>
    <Wrapper variant="standard" class="pt-48 pb-24">
      <div class="max-w-2xl mx-auto">
        <Text
          tag="h1"
          variant="displayLG"
          class="text-accent-950 uppercase font-display font-medium text-balance"
        >
          Consulting
        </Text>
        <Text tag="p" variant="textBase" class="mt-4 text-base-500">
          Scientific software consulting for research labs and industry —
          custom solvers, multiphysics modeling, and simulation acceleration.
        </Text>
      </div>
    </Wrapper>
  </section>
  <ConsultingCards />
</BaseLayout>
