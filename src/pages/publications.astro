---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/mesh/PageHeader.astro";
import publications from "@/data/publications.json";

type Author = { first: string; last: string };
type Pub = (typeof publications)[number]["items"][number];

const short: Record<string, string> = {
  "Articles in international peer-reviewed journals": "Journal articles",
  "Contribution to a book chapter": "Book chapter",
  "Proceedings of international peer-reviewed conferences": "Conference proceedings",
  "International peer-reviewed conferences": "International conferences",
  "National conferences and seminars": "National conferences and seminars",
  "PhD thesis": "PhD thesis",
  "Software and codes": "Software",
};

const slug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "");

function authors(list: Author[]) {
  return (list ?? []).map((a) => ({
    name: `${a.first} ${a.last}`,
    self: a.last === "Vial" && a.first.startsWith("B"),
  }));
}

function venue(p: Pub) {
  let v = "";
  const pages = (p.pages || "").replace(/--/g, "–");
  if (p.type === "article") {
    v = p.journal || "";
    if (p.volume) v += ` ${p.volume}`;
    if (p.number) v += ` (${p.number})`;
    if (pages) v += `, ${pages}`;
  } else if (p.type === "inproceedings") {
    v = p.booktitle || "";
    if (p.volume) v += ` ${p.volume}`;
    if (pages) v += `, ${pages}`;
    if (p.address) v += `, ${p.address}`;
    if (p.note) v += `, ${p.note}`;
  } else if (p.type === "phdthesis") {
    v = p.school || "";
  } else if (p.type === "book") {
    if (p.editor && p.editor !== p.title) v = `edited by ${p.editor}`;
    if (p.isbn) v += (v ? ", " : "") + `ISBN ${p.isbn}`;
  } else {
    v = p.howpublished || p.journal || "";
  }
  return v;
}

const groups = publications.map((g) => ({
  id: slug(short[g.category] ?? g.category),
  title: short[g.category] ?? g.category,
  items: [...g.items].sort((a, b) => Number(b.year) - Number(a.year)),
}));
---

<BaseLayout title="Publications" description="Journal articles, conference papers, thesis and software by Benjamin Vial.">
  <PageHeader
    title="Publications"
    lede="Peer-reviewed work in wave physics, metamaterials, nanophotonics and computational electromagnetics."
  />

  <div class="page grid gap-10 pt-12 lg:grid-cols-12">
    <nav aria-label="Categories" class="lg:col-span-3">
      <ul class="grid gap-1 border-t border-ink pt-3 lg:sticky below-nav">
        {
          groups.map((g) => (
            <li class="flex items-baseline justify-between gap-4">
              <a class="link no-underline hover:underline" href={`#${g.id}`}>
                {g.title}
              </a>
              <span class="t-mono text-ink-3">{g.items.length}</span>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="min-w-0 lg:col-span-9">
      {
        groups.map((g) => (
          <section id={g.id} aria-labelledby={`h-${g.id}`} class="scroll-mt-8 pb-16">
            <h2 id={`h-${g.id}`} class="t-h2 border-b border-ink pb-3">
              {g.title}
            </h2>
            <ol class="rows">
              {g.items.map((p) => (
                <li class="grid gap-x-6 gap-y-1 py-4 sm:grid-cols-[4.5rem_1fr]">
                  <span class="t-mono pt-1 text-ink-3">{p.year}</span>
                  <div class="min-w-0">
                    <p class="font-semibold leading-snug text-ink">{p.title}</p>
                    <p class="mt-1 text-[0.9375rem] text-ink-2">
                      {authors(p.authors).map((a, i, all) => (
                        <>
                          <span class:list={[a.self && "text-ink underline decoration-warm decoration-1 underline-offset-[0.2em]"]}>
                            {a.name}
                          </span>
                          {i < all.length - 1 ? ", " : ""}
                        </>
                      ))}
                    </p>
                    <p class="mt-1 text-[0.9375rem] italic text-ink-2">{venue(p)}</p>
                    {(p.doi || p.url) && (
                      <p class="t-mono mt-2 flex flex-wrap gap-x-4">
                        {p.doi && (
                          <a class="link" href={`https://doi.org/${p.doi}`} rel="noopener">
                            doi:{p.doi}
                          </a>
                        )}
                        {p.url && !p.doi && (
                          <a class="link break-all" href={p.url} rel="noopener">
                            {p.url.replace(/^https?:\/\//, "")}
                          </a>
                        )}
                      </p>
                    )}
                  </div>
                </li>
              ))}
            </ol>
          </section>
        ))
      }
    </div>
  </div>
</BaseLayout>
