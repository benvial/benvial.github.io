---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import ResearchCards from "@/components/landing/ResearchCards.astro";
import { getCollection } from "astro:content";

const entries = await getCollection("research");
---

<BaseLayout>
  <section>
    <Wrapper variant="standard" class="pt-48 pb-24">
      <div class="max-w-2xl mx-auto">
        <Text
          tag="h1"
          variant="displayLG"
          class="text-accent-950 uppercase font-display font-medium text-balance"
        >
          Research
        </Text>
        <Text tag="p" variant="textBase" class="mt-4 text-base-500">
          Exploring wave physics, metamaterials, and computational electromagnetics
          through theory, numerical simulation, and experiment.
        </Text>
      </div>
    </Wrapper>
  </section>
  <ResearchCards entries={entries} />
</BaseLayout>
