---
import { getCollection, render } from "astro:content";
import LessonLayout from "@/layouts/LessonLayout.astro";

export async function getStaticPaths() {
  const lessons = await getCollection("lessons");

  return lessons.map((lesson) => {
    const [courseSlug, lessonSlug] = lesson.id.split("/");
    return {
      params: {
        course: courseSlug,
        lesson: lessonSlug,
      },
      props: {
        courseSlug,
        lessonSlug: lesson.id,
      },
    };
  });
}


const { courseSlug, lessonSlug } = Astro.props;

const courses = await getCollection("courses");
const lessons = await getCollection("lessons");

const course = courses.find((c) => c.id === courseSlug);
const lesson = lessons.find((l) => l.id === lessonSlug);

if (!course || !lesson) {
  throw new Error("Course or lesson not found");
}

const { Content } = await render(lesson);
---
<LessonLayout course={course} lesson={lesson}>
  <Content />
</LessonLayout>
