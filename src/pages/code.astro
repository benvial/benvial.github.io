---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/mesh/PageHeader.astro";
import PackageRow from "@/components/sections/PackageRow.astro";
import ActivityGraph from "@/components/sections/ActivityGraph.astro";

const all = (await getCollection("code")).sort((a, b) => a.id.localeCompare(b.id));

const sections = [
  {
    id: "packages",
    title: "Packages",
    lede: "Solvers and tools I develop, most of them behind the papers.",
  },
  {
    id: "wheels",
    title: "Solver wheels",
    lede: "Pip-installable builds of established simulation codes, with every native dependency inside the wheel.",
  },
  {
    id: "conda-forge",
    title: "conda-forge",
    lede: "Feedstocks I maintain on conda-forge.",
  },
].map((s) => ({ ...s, items: all.filter((p) => p.data.section === s.id) }));
---

<BaseLayout title="Code" description="Open-source packages for computational electromagnetics, numerical methods and scientific computing.">
  <PageHeader
    title="Code"
    lede="Open-source packages for computational electromagnetics, numerical methods and scientific computing."
  />
  <div class="page pt-12">
    <section id="activity" aria-labelledby="h-activity" class="scroll-mt-8 pb-16">
      <h2 id="h-activity" class="t-h2 border-b border-ink pb-3">Activity</h2>
      <p class="mt-4 mb-8 max-w-[60ch] text-ink-2">Commits, issues and reviews across my public repositories over the past year.</p>
      <ActivityGraph />
    </section>
    {
      sections.map((s) => (
        <section id={s.id} aria-labelledby={`h-${s.id}`} class="scroll-mt-8 pb-16">
          <h2 id={`h-${s.id}`} class="t-h2 border-b border-ink pb-3">
            {s.title}
          </h2>
          <p class="mt-4 max-w-[60ch] text-ink-2">{s.lede}</p>
          <ul class="rows">
            {s.items.map((pkg) => <PackageRow pkg={pkg} />)}
          </ul>
        </section>
      ))
    }
  </div>
</BaseLayout>
