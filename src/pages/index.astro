---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import MeshField from "@/components/mesh/MeshField.astro";
import Readout from "@/components/mesh/Readout.astro";
import PostRow from "@/components/sections/PostRow.astro";
import PackageRow from "@/components/sections/PackageRow.astro";
import Arrow from "@/components/fundations/icons/Arrow.astro";
import { services, site } from "@/data/site";

const research = (await getCollection("research")).sort(
  (a, b) =>
    (a.data.order ?? Infinity) - (b.data.order ?? Infinity) ||
    b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const packages = (await getCollection("code", (p) => p.data.section === "packages")).sort((a, b) => a.id.localeCompare(b.id)).slice(0, 6);
const posts = (await getCollection("posts"))
  .sort((a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf())
  .slice(0, 3);
---

<BaseLayout>
  <MeshField
    animate
    class="min-h-[max(36rem,min(88svh,54rem))]"
    sourceX={0.57}
    sourceY={0.45}
    wavelengths={9}
    pad={28}
    intensity={0.78}
  >
    <div class="page relative flex min-h-[inherit] flex-col justify-between gap-10 pt-[clamp(2.5rem,9vh,6rem)] pb-20 lg:pb-36">
      <h1 data-obstacle class="t-name w-fit bg-paper">
        Benjamin<br />Vial
      </h1>

      <div class="flex h-[min(26svh,12rem)] items-end justify-end lg:hidden">
        <p data-obstacle data-obstacle-pad="0" data-mesh-readout class="mesh-readout t-mono border border-rule px-2 py-1 text-[0.6875rem]">
          <span data-k="nodes">…</span> nodes · <span data-k="ms">…</span>
        </p>
      </div>

      <div class="flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between">
        <div data-obstacle class="flex max-w-[36rem] flex-col gap-5 bg-paper lg:gap-6">
          <p class="t-lede text-[1.0625rem] text-ink sm:text-[length:inherit]">
            I study how electromagnetic and elastic waves behave in structured materials, and I write the
            open-source codes that compute them.<br />
            I build that software for research labs and industry.
          </p>
          <div class="flex flex-wrap gap-3">
            <a class="door door--primary" href="/consulting">Consulting <Arrow /></a>
            <a class="door" href="/research">Research <Arrow /></a>
          </div>
        </div>
        <Readout class="hidden w-fit lg:grid lg:self-end" />
      </div>
    </div>
  </MeshField>

  <!-- Consulting -->
  <section aria-labelledby="h-consulting" class="page grid gap-10 pt-24 lg:grid-cols-12">
    <div class="lg:col-span-4">
      <div class="lg:sticky below-nav">
        <h2 id="h-consulting" class="t-h2">What I build for you</h2>
        <p class="mt-4 max-w-[34ch] text-ink-2">
          Scientific software for research labs and industry: inverse design, custom solvers and
          multiphysics models.
        </p>
        <a class="door mt-6" href="/consulting">Consulting <Arrow /></a>
      </div>
    </div>
    <ol class="rows lg:col-span-8">
      {
        services.map((s) => (
          <li class="grid gap-x-8 gap-y-2 py-6 md:grid-cols-8">
            <h3 class="t-h3 md:col-span-3">{s.title}</h3>
            <div class="md:col-span-5">
              <p class="text-ink-2">{s.body}</p>
              <p class="t-meta mt-3">{s.tools.join(" · ")}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- Research -->
  <section aria-labelledby="h-research" class="page pt-28">
    <div class="flex flex-wrap items-end justify-between gap-6 border-b border-ink pb-5">
      <div>
        <h2 id="h-research" class="t-h2">Research</h2>
        <p class="mt-3 max-w-[48ch] text-ink-2">
          Light, sound and vibration in structured media since 2009 (resonances, homogenization and
          inverse design), at Institut Fresnel, Queen Mary and Imperial College London.
        </p>
      </div>
      <a class="link t-label" href="/publications">All publications</a>
    </div>
    <ul class="mt-10 grid gap-x-8 gap-y-14 md:grid-cols-12">
      {
        research.map((entry, i) => (
          <li class:list={[i % 4 === 0 || i % 4 === 3 ? "md:col-span-7" : "md:col-span-5"]}>
            <a href={`/research/${entry.id}/`} class="group block">
              <figure>
                <div class="overflow-hidden border border-rule bg-white">
                  <Image
                    src={entry.data.image.url}
                    alt={entry.data.image.alt}
                    widths={[480, 800, 1100]}
                    sizes="(min-width: 768px) 55vw, 100vw"
                    class="aspect-[4/3] w-full object-contain p-3 transition-transform duration-500 ease-out group-hover:scale-[1.02]"
                  />
                </div>
                <figcaption class="mt-3 grid gap-1">
                  <span class="t-h3 transition-colors group-hover:text-warm">
                    <span class="font-sans text-[0.9375rem] font-semibold text-ink-3">Fig. {i + 1}.{" "}</span>
                    {entry.data.title}
                  </span>
                  <span class="text-ink-2">{entry.data.description}</span>
                </figcaption>
              </figure>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Code -->
  <section aria-labelledby="h-code" class="page pt-28">
    <div class="flex flex-wrap items-end justify-between gap-6 pb-5">
      <div>
        <h2 id="h-code" class="t-h2">Code</h2>
        <p class="mt-3 max-w-[48ch] text-ink-2">
          The solvers behind the papers, published as open-source Python packages.
        </p>
      </div>
      <a class="link t-label" href="/code">All packages</a>
    </div>
    <ul class="rows">
      {packages.map((pkg) => <PackageRow pkg={pkg} />)}
    </ul>
  </section>

  <!-- Writing -->
  <section aria-labelledby="h-writing" class="page pt-28">
    <div class="flex flex-wrap items-end justify-between gap-6 pb-5">
      <h2 id="h-writing" class="t-h2">Writing</h2>
      <a class="link t-label" href="/blog">All posts</a>
    </div>
    <ul class="rows">
      {posts.map((post) => <PostRow post={post} />)}
    </ul>
  </section>

  <!-- Close -->
  <MeshField class="mt-28 min-h-[22rem]" sourceX={0.08} sourceY={0.3} wavelengths={10} pad={16} intensity={0.6}>
    <div class="page flex min-h-[inherit] items-center justify-end py-12">
      <div data-obstacle class="flex max-w-[32rem] flex-col gap-5 bg-paper">
        <h2 class="t-display">Have a wave problem?</h2>
        <p class="text-ink-2">
          Tell me what you need to simulate, for a research collaboration or a consulting project.
        </p>
        <div class="flex flex-wrap gap-3">
          <a class="door door--primary" href="/contact">Get in touch <Arrow /></a>
          <a class="door" href={site.cv}>CV (PDF)</a>
        </div>
      </div>
    </div>
  </MeshField>
</BaseLayout>
