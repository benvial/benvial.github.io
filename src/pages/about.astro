---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/mesh/PageHeader.astro";
import Arrow from "@/components/fundations/icons/Arrow.astro";
import { awards, education, positions, skills, teaching, type CvItem } from "@/data/cv";
import { site } from "@/data/site";

const sections: { id: string; title: string; items: CvItem[] }[] = [
  { id: "positions", title: "Positions", items: positions },
  { id: "education", title: "Education", items: education },
  { id: "teaching", title: "Teaching and supervision", items: teaching },
  { id: "awards", title: "Awards", items: awards },
];
---

<BaseLayout title="About" description="Biography and CV of Benjamin Vial, wave physicist and scientific software developer.">
  <PageHeader
    title="About"
    lede="Research scientist and freelance developer working where wave physics, computational electromagnetics and open-source scientific software meet."
  />

  <section class="page grid gap-10 pt-14 lg:grid-cols-12">
    <figure class="lg:col-span-4">
      <img
        src="/face.jpg"
        alt="Portrait of Benjamin Vial"
        width="560"
        height="560"
        class="aspect-square w-full max-w-[22rem] border border-rule object-cover"
      />
      <!-- <figcaption class="t-meta mt-2">{site.location}</figcaption> -->
    </figure>
    <div class="prose max-w-[40rem] lg:col-span-8">
      <p>I'm a research scientist and software developer based in France. My work sits at the intersection of wave physics and computational engineering, where I build open-source numerical tools and use them to explore how electromagnetic and mechanical waves behave in structured materials.</p>
      <p>I received my Master's degrees in Engineering from <a href="https://www.centrale-marseille.fr/">Centrale Marseille</a> and in Physics from <a href="https://edu.univ-amu.fr/en">Aix Marseille University</a> in 2009. I then joined the <a href="https://www.fresnel.fr/spip/?&lang=en">Fresnel Institute</a> (CNRS), where I pursued a PhD in collaboration with <a href="https://www.silios.com/">Silios Technologies</a>. My thesis focused on the theoretical, numerical and experimental study of electromagnetic metamaterials using a modal approach, applied to infrared multispectral filtering. I received my PhD from Centrale Marseille in April 2013.</p>
      <p>After two postdoctoral positions at the Fresnel Institute (first on ray tracing in complex media, then on resonant optical antennas), I moved to London in 2014 to join the <a href="https://antennas.eecs.qmul.ac.uk/">Antennas and Electromagnetics group</a> at <a href="https://www.qmul.ac.uk/">Queen Mary, University of London</a>. Over eight years there I worked on topology optimization for invisibility cloaks, machine-learning-driven inverse design, and the homogenization of ferroelectric metamaterials for tunable microwave devices.</p>
      <p>From 2022 to 2025 I was a Postdoctoral Research Assistant at <a href="https://www.imperial.ac.uk">Imperial College London</a> in the <a href="https://www.imperial.ac.uk/mathematics/">Department of Mathematics</a>, where I worked on high-frequency homogenization of dispersive media for vibration energy harvesting with metamaterials. Since late 2025 I work independently as a freelance software developer, consulting and building open-source tools for photonics and electronics (including <a href="https://github.com/gdsfactory/gsim">gsim</a>, a GDSFactory plugin for full-wave electromagnetic simulation).</p>
      <p class="not-prose pt-2"><a class="door" href={site.cv}>Download CV (PDF) <Arrow /></a></p>
    </div>
  </section>

  <div class="page grid gap-10 pt-24 lg:grid-cols-12">
    <nav aria-label="CV sections" class="lg:col-span-3">
      <ul class="grid gap-1 border-t border-ink pt-3 lg:sticky lg:top-8">
        {sections.map((s) => (
          <li><a class="link no-underline hover:underline" href={`#${s.id}`}>{s.title}</a></li>
        ))}
        <li><a class="link no-underline hover:underline" href="#skills">Skills and interests</a></li>
      </ul>
    </nav>
    <div class="min-w-0 lg:col-span-9">
      {
        sections.map((s) => (
          <section id={s.id} aria-labelledby={`h-${s.id}`} class="scroll-mt-8 pb-16">
            <h2 id={`h-${s.id}`} class="t-h2 border-b border-ink pb-3">{s.title}</h2>
            <ol class="rows">
              {s.items.map((it) => (
                <li class="grid gap-x-6 gap-y-1 py-4 sm:grid-cols-[11rem_1fr]">
                  <span class="t-mono pt-1 text-ink-3">{it.period}</span>
                  <div>
                    <p class="t-h3">{it.title}</p>
                    <p class="text-ink-2">{it.where}</p>
                    {it.detail && <p class="mt-1 text-[0.9375rem] text-ink-2">{it.detail}</p>}
                  </div>
                </li>
              ))}
            </ol>
          </section>
        ))
      }
      <section id="skills" aria-labelledby="h-skills" class="scroll-mt-8">
        <h2 id="h-skills" class="t-h2 border-b border-ink pb-3">Skills and interests</h2>
        <dl class="rows">
          {skills.map((s) => (
            <div class="grid gap-x-6 gap-y-1 py-4 sm:grid-cols-[11rem_1fr]">
              <dt class="t-label pt-1 text-ink-3">{s.label}</dt>
              <dd class="text-ink-2">{s.value}</dd>
            </div>
          ))}
        </dl>
      </section>
    </div>
  </div>
</BaseLayout>
